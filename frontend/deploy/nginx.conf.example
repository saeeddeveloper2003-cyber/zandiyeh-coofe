# Example nginx config for deploying the built frontend (vite build output
# in ./dist) on a plain VPS instead of Vercel/Netlify.
#
# Two things this config MUST do, or the Zarinpal payment flow breaks:
#   1. SPA fallback — /checkout/result (and any other client route) has no
#      matching file on disk, so nginx must fall back to index.html instead
#      of returning 404 when the user's browser is redirected back from
#      Zarinpal.
#   2. Proxy /api/* to the backend — unless you're setting VITE_API_BASE_URL
#      to a separate backend domain, in which case you can drop this block.
#
# Copy this file to /etc/nginx/sites-available/zandieh, adjust the paths and
# domain, then symlink it into sites-enabled and reload nginx.

server {
    listen 80;
    server_name your-domain.example.com;

    root /var/www/zandieh-frontend/dist;
    index index.html;

    # Static assets — allow long-term caching.
    location /assets/ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Proxy API calls to the backend. Remove this block if the frontend
    # talks to a separately-hosted backend domain via VITE_API_BASE_URL.
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback — required for /checkout/result to work after the
    # Zarinpal redirect. Must come after /assets/ and /api/.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
