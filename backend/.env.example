# Server
PORT=4000

# ⚠️ PRODUCTION: must be your real public backend domain (https://...), not
# localhost — Zarinpal calls this URL directly to deliver the payment result,
# so it has to be reachable from the internet.
BACKEND_PUBLIC_URL=http://localhost:4000

# ⚠️ PRODUCTION: must be your real public frontend domain (https://...).
# Used for CORS (requests from any other origin are rejected) and as the
# base of the /checkout/result redirect after payment. Getting this wrong
# either breaks checkout (CORS errors) or sends customers to the wrong URL.
# Comma-separate multiple origins if needed, e.g. "https://a.com,https://b.com".
FRONTEND_PUBLIC_URL=http://localhost:5173

# Zarinpal
# ⚠️ PRODUCTION: set this to "false" before going live. Leaving it "true"
# means real customers are charged through the Zarinpal *sandbox*, i.e. no
# real payment ever happens. server.js refuses to boot with SANDBOX=false
# unless ZARINPAL_MERCHANT_ID below is also a real (non-placeholder) value.
ZARINPAL_SANDBOX=true
# Get this from your Zarinpal panel: https://next.zarinpal.com/panel/
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# External gateway timeout in milliseconds. Prevents a hung gateway from holding stock forever.
ZARINPAL_TIMEOUT_MS=15000

# SQLite file location (defaults to ./zandieh.db if omitted)
# ⚠️ PRODUCTION: this file must live on persistent disk. Do NOT deploy this
# backend to a serverless/ephemeral-filesystem platform (Vercel Functions,
# AWS Lambda, etc.) — the database would reset on every cold start. Use a
# regular VPS/container host with a persistent volume, and back it up
# regularly (see `npm run backup`).
# DB_PATH=./zandieh.db

# Authentication / sessions
# 30 days by default. In production use HTTPS and keep SameSite=None when
# frontend and backend are on different sites/domains.
SESSION_TTL_SECONDS=2592000
SESSION_COOKIE_SAMESITE=lax
# NODE_ENV=production

# Set true only when this app is actually behind your trusted reverse proxy/load balancer.
TRUST_PROXY=false
